{
  "expo": {
    "name": "TUNG",
    "slug": "tung",
    "owner": "one-black-cloud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tung",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.tung.dating",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tung.dating",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#2A0B2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#471448",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "TUNG uses your microphone to record voice introductions and voice messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TUNG uses your photos so you can add them to your profile.",
          "cameraPermission": "TUNG uses your camera so you can take profile photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TUNG uses your location to show you people nearby. Your exact location is never shown."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "TUNG uses your camera to record your video introduction.",
          "microphonePermission": "TUNG uses your microphone so people can hear you in your video introduction.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a976eabb-d85c-4d94-90fe-99dee4fca55d"
      }
    }
  }
}
