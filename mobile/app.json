{
  "expo": {
    "name": "VOYC",
    "slug": "voyc-date",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voyc",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0F4C5C",
    "ios": {
      "bundleIdentifier": "com.voyc.date",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.voyc.date",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#08343F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F4C5C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "VOYC uses your microphone to record voice introductions and voice messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VOYC uses your photos so you can add them to your profile.",
          "cameraPermission": "VOYC uses your camera so you can take profile photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VOYC uses your location to show you people nearby. Your exact location is never shown."
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "VOYC uses your camera to record your video introduction.",
          "microphonePermission": "VOYC uses your microphone so people can hear you in your video introduction.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
