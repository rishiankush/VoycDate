{
  "expo": {
    "name": "VOYC",
    "slug": "voyc-date",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voyc",
    "userInterfaceStyle": "light",
    "backgroundColor": "#471448",
    "ios": {
      "bundleIdentifier": "com.voyc.date",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.voyc.date",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#2A0B2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#471448",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "VOYC uses your microphone to record voice introductions and voice messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VOYC uses your photos so you can add them to your profile.",
          "cameraPermission": "VOYC uses your camera so you can take profile photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VOYC uses your location to show you people nearby. Your exact location is never shown."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#471448",
          "defaultChannel": "voyc-default",
          "sounds": []
        }
      ],

      [
        "expo-camera",
        {
          "cameraPermission": "VOYC uses your camera to record your video introduction.",
          "microphonePermission": "VOYC uses your microphone so people can hear you in your video introduction.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "96bca604-090b-4bda-86be-c6c157a6b0bf"
      }
    },
    "owner": "rishiankush5"
  }
}
